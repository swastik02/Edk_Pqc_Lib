[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PqcCryptLib
  MODULE_UNI_FILE                = PqcCryptLib.uni
  FILE_GUID                      = 103D43A4-C992-4812-9F9A-025210947A1D
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = PqcCryptLib|DXE_DRIVER DXE_CORE UEFI_APPLICATION UEFI_DRIVER

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 AARCH64 RISCV64 LOONGARCH64
#

[Sources]
  Hash/InternalCryptLib.h
  Hash/keccak1600.c
  Hash/CryptSha3.c


# [Sources.Ia32]
#   Rand/CryptRandTsc.c

# [Sources.X64]
