# [Sources.RISCV64]
#   Rand/CryptRand.c

# [Sources.LOONGARCH64]
#   Rand/CryptRand.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  UefiRuntimeServicesTableLib
  DebugLib
  IntrinsicLib
  PrintLib
  UefiBootServicesTableLib
  SynchronizationLib

